# App-only bearer for public X API v2 reads (Spaces search, lookup).
X_API_BEARER_TOKEN=

# Global cooldown between Refresh-triggered X fetches (seconds). Default 1800.
REFRESH_COOLDOWN_SECONDS=1800

# Cloudflare Web Analytics beacon token. Leave empty locally. Set at deploy.
# Never commit a real token.
CLOUDFLARE_WEB_ANALYTICS_TOKEN=
